    repository-code: "https://github.com/flatironinstitute/fmm2d"
    url: "https://fmm2d.readthedocs.io"
    license: Apache-2.0
    notes: "The Stokes FMM (stfmm2d) used through SCTL's ParticleFMM; a git submodule in extern/fmm2d."
