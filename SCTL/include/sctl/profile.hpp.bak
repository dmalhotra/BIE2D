#ifndef _SCTL_PROFILE_HPP_
#define _SCTL_PROFILE_HPP_

#include <sctl/common.hpp>

#include <string>
#include <vector>
#include <stack>
#include <atomic>

#ifndef SCTL_PROFILE
#define SCTL_PROFILE -1
#endif

namespace SCTL_NAMESPACE {

class Comm;

enum class ProfileCounter: Long {
  TIME,
  FLOP,
  HEAP_ALLOC_COUNT,
  HEAP_ALLOC_BYTES,
  HEAP_FREE_COUNT,
  HEAP_FREE_BYTES,
  PROF_MPI_BYTES,
  PROF_MPI_COUNT,
  PROF_MPI_COLLECTIVE_BYTES,
  PROF_MPI_COLLECTIVE_COUNT,
  CUSTOM1,
  CUSTOM2,
  CUSTOM3,
  CUSTOM4,
  CUSTOM5,
  FIELD_COUNT
};

template <typename E> class ProfExpr {
  public:

    std::vector<double> operator()(const std::vector<double>& counters) const {
      return ((const E*)this)->operator()(counters);
    }

    static void* CopyInstance(const void* self) {
      E* expr = new E(*(E*)self);
      return expr;
    }

    static std::vector<double> Eval(const std::vector<double>& counters, const void* self) {
      return ((const E*)self)->operator()(counters);
    }

    static void DeleteInstance(void** self_ptr) {
      SCTL_ASSERT(self_ptr);
      if (!*self_ptr) return;
      delete (E*)(*self_ptr);
      (*self_ptr) = nullptr;
    }
};

template <> class ProfExpr<void> {
  public:

    ProfExpr() : instance(nullptr) {}

    template <class E> ProfExpr(const ProfExpr<E>& e) : instance(nullptr) {
      Copy(e);
    }

    ProfExpr(const ProfExpr<void>& e) : instance(nullptr) {
      Copy(e);
    }

    template <class E> ProfExpr<void>& operator=(const ProfExpr<E>& e) {
      Copy(e);
      return *this;
    }

    ProfExpr<void>& operator=(const ProfExpr<void>& e) {
      Copy(e);
      return *this;
    }

    ~ProfExpr() {
      del_fn(&instance);
    }


    std::vector<double> operator()(const std::vector<double>& counters) const {
      return eval_fn(counters, instance);
    }

    static void* CopyInstance(const void* self) {
      ProfExpr<void>* instance_ptr = new ProfExpr<void>;
      const auto self_ = (ProfExpr<void>*)self;
      instance_ptr->copy_fn = self_->copy_fn;
      instance_ptr->eval_fn = self_->eval_fn;
      instance_ptr->del_fn = self_->del_fn;
      instance_ptr->instance = self_->copy_fn(self_->instance);
      return instance_ptr;
    }

    static std::vector<double> Eval(const std::vector<double>& counters, const void* self) {
      const auto self_ = (ProfExpr<void>*)self;
      return self_->eval_fn(counters, self_->instance);
    }

    static void DeleteInstance(void** self_ptr) {
      SCTL_ASSERT(self_ptr);
      if (!*self_ptr) return;
      delete (ProfExpr<void>*)*self_ptr;
      (*self_ptr) = nullptr;
    }

  private:

    template <class Expr> void Copy(const Expr& e) {
      if (instance) del_fn(&instance);
      copy_fn = Expr::CopyInstance;
      eval_fn = Expr::Eval;
      del_fn = Expr::DeleteInstance;
      instance = copy_fn(&e);
    }

    void Copy(const ProfExpr<void>& e) {
      if (instance) del_fn(&instance);
      copy_fn = e.copy_fn;
      eval_fn = e.eval_fn;
      del_fn = e.del_fn;
      instance = copy_fn(e.instance);
    }

    void* (*copy_fn)(const void*);
    std::vector<double> (*eval_fn)(const std::vector<double>&, const void*);
    void (*del_fn)(void**);
    void* instance;
};



class Expr : public ProfExpr<Expr> {
  public:

    Expr() = default;

    Expr(ProfileCounter field) : field_((Long)field), value_(0) {}

    Expr(double value) : field_((Long)ProfileCounter::FIELD_COUNT), value_(value) {}

    std::vector<double> operator()(const std::vector<double>& counters) const {
      const Long Nfield = (Long)ProfileCounter::FIELD_COUNT;
      const Long N = counters.size() / Nfield;
      std::vector<double> val_vec(N);
      if (field_ == Nfield) {
        for (Long i = 0; i < N; i++) {
          val_vec[i] = value_;
        }
      } else {
        for (Long i = 0; i < N; i++) {
          val_vec[i] = counters[i*Nfield + field_];
        }
      }
      return val_vec;
    }

  private:
    Long field_;
    double value_;
};

template <class UnaryOp> class ExprUnary : public ProfExpr<ExprUnary<UnaryOp>> {
  public:

    ExprUnary() = default;

    ExprUnary(const ProfExpr<void>& e1, const UnaryOp& op) : e1_(e1), op_(op) {}

    std::vector<double> operator()(const std::vector<double>& counters) const {
      return op_(e1_(counters));
    }

  private:
    ProfExpr<void> e1_;
    UnaryOp op_;
};

template <class BinaryOp> class ExprBinary : public ProfExpr<ExprBinary<BinaryOp>> {
  public:

    ExprBinary() = default;

    ExprBinary(const ProfExpr<void>& e1, const ProfExpr<void>& e2, const BinaryOp& op) : e1_(e1), e2_(e2), op_(op) {}

    std::vector<double> operator()(const std::vector<double>& counters) const {
      return op_(e1_(counters), e2_(counters));
    }

  private:
    ProfExpr<void> e1_, e2_;
    BinaryOp op_;
};

ProfExpr<void> operator+(const ProfExpr<void>& u, const ProfExpr<void>& v) {
  const auto op = [](std::vector<double> x, const std::vector<double>& y) {
    SCTL_ASSERT(x.size() == y.size());
    for (Long i = 0; i < (Long)x.size(); i++) x[i] += y[i];
    return x;
  };
  return ExprBinary<decltype(op)>(u, v, op);
}

ProfExpr<void> operator-(const ProfExpr<void>& u, const ProfExpr<void>& v) {
  const auto op = [](std::vector<double> x, const std::vector<double>& y) {
    SCTL_ASSERT(x.size() == y.size());
    for (Long i = 0; i < (Long)x.size(); i++) x[i] -= y[i];
    return x;
  };
  return ExprBinary<decltype(op)>(u, v, op);
}

ProfExpr<void> operator*(const ProfExpr<void>& u, const ProfExpr<void>& v) {
  const auto op = [](std::vector<double> x, const std::vector<double>& y) {
    SCTL_ASSERT(x.size() == y.size());
    for (Long i = 0; i < (Long)x.size(); i++) x[i] *= y[i];
    return x;
  };
  return ExprBinary<decltype(op)>(u, v, op);
}

ProfExpr<void> operator/(const ProfExpr<void>& u, const ProfExpr<void>& v) {
  const auto op = [](std::vector<double> x, const std::vector<double>& y) {
    SCTL_ASSERT(x.size() == y.size());
    for (Long i = 0; i < (Long)x.size(); i++) x[i] /= y[i];
    return x;
  };
  return ExprBinary<decltype(op)>(u, v, op);
}

ProfExpr<void> operator*(const ProfExpr<void>& u, const double a) {
  const auto op = [a](std::vector<double> x) {
    for (Long i = 0; i < (Long)x.size(); i++) x[i] *= a;
    return x;
  };
  return ExprUnary<decltype(op)>(u, op);
}





class Profile {
  static constexpr Long Nfield = (Long)ProfileCounter::FIELD_COUNT;

 public:
  static Long IncrementCounter(const ProfileCounter prof_field, const Long x);

  static bool Enable(bool state);

  static void Tic(const char* name_, const Comm* comm_ = nullptr, bool sync_ = false, Integer verbose = 1);

  static void Toc();

  static const ProfExpr<void>& GetProfField(const std::string& name) {
    SCTL_ASSERT_MSG(ProfData().prof_fields.count(name), "Unknown profile field name.");
    return ProfData().prof_fields[name];
  }

  static void SetProfField(const std::string& name, const ProfExpr<void>& expr) {
    ProfData().prof_fields[name] = expr;
  }

  static void print(const Comm* comm_ = nullptr, std::vector<std::string> fields = {}, std::vector<std::string> format = {});

  static void reset();

 private:
  struct ProfileData {
    const double t0;
    bool enable_state;

    std::stack<int> verb;
    std::stack<bool> sync;
    std::stack<std::string> name;
    std::stack<const Comm*> comm;

    std::vector<bool> e_log;
    std::vector<std::string> n_log;
    std::vector<double> counter_log;

    std::array<std::atomic<Long>, Nfield> counters;
    std::map<std::string, ProfExpr<void>> prof_fields;

    ProfileData() : t0(omp_get_wtime()), enable_state(false) {
      constexpr double gb_scale = (1./1024/1024/1024);
      for (auto& x : counters) x = 0;

      prof_fields["time"]  = Expr(ProfileCounter::TIME) * 1e-9;
      prof_fields["gflop"] = Expr(ProfileCounter::FLOP) * 1e-9;

      prof_fields["alloc_gb"]    = Expr(ProfileCounter::HEAP_ALLOC_BYTES) * gb_scale;
      prof_fields["alloc_count"] = Expr(ProfileCounter::HEAP_ALLOC_COUNT);

      prof_fields["free_gb" ]   = Expr(ProfileCounter::HEAP_FREE_BYTES) * gb_scale;
      prof_fields["free_count"] = Expr(ProfileCounter::HEAP_FREE_COUNT);

      prof_fields["comm_gb"]         = Expr(ProfileCounter::PROF_MPI_BYTES) * gb_scale;
      prof_fields["comm_count"]      = Expr(ProfileCounter::PROF_MPI_COUNT);

      prof_fields["comm_coll_gb"]    = Expr(ProfileCounter::PROF_MPI_COLLECTIVE_BYTES) * gb_scale;
      prof_fields["comm_coll_count"] = Expr(ProfileCounter::PROF_MPI_COLLECTIVE_COUNT);

      prof_fields["custom1"] = Expr(ProfileCounter::CUSTOM1);
      prof_fields["custom2"] = Expr(ProfileCounter::CUSTOM2);
      prof_fields["custom3"] = Expr(ProfileCounter::CUSTOM3);
      prof_fields["custom4"] = Expr(ProfileCounter::CUSTOM4);
      prof_fields["custom5"] = Expr(ProfileCounter::CUSTOM5);

      prof_fields["gflop/s"] = prof_fields["gflop"] / prof_fields["time"];
      prof_fields["gb_change"] = prof_fields["alloc_gb"] - prof_fields["free_gb"];
    }
  };

  static inline ProfileData& ProfData() {
    static ProfileData p;
    return p;
  }


};

}  // end namespace

#include SCTL_INCLUDE(profile.txx)

#endif  //_SCTL_PROFILE_HPP_
